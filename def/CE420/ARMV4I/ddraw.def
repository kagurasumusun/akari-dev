; Public import surface for ddraw.dll (CE420, ARMV4I).
; Export names and ordinals recorded from the CE module survey.
; Non-import-library exports are omitted. This text is original.
LIBRARY ddraw.dll
EXPORTS
  DirectDrawCreate
  DirectDrawCreateClipper
  DirectDrawEnumerateA
  DirectDrawEnumerateW
  DirectDrawEnumerateExA
  DirectDrawEnumerateExW
  D3D8DeleteDirectDrawObject
  D3D8SetMode
  D3D8GetMode
  D3D8BuildModeTable
  D3D8QueryDirectDrawObject
  D3D8ReenableDirectDrawObject
  D3D8CreateDirectDrawObject
  D3D8LoseDevice
  D3D8CanRestoreNow
  D3D8IsDeviceLost
  D3D8IsDummySurface
  D3D8SetCooperativeLevel
  D3D8RestoreDevice
  D3D8DoVidmemSurfacesExist
  D3D8SetGammaRamp
  D3D8PerformCallback
