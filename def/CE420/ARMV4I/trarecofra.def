; Public import surface for trarecofra.dll (CE420, ARMV4I).
; Export names and ordinals recorded from the CE module survey.
; Non-import-library exports are omitted. This text is original.
LIBRARY trarecofra.dll
EXPORTS
  CgrGetRecID @100
  CgrCreateContext @101
  CgrCloseContext @102
  CgrOpenSession @103
  CgrCloseSession @104
  CgrRecognize @105
  CgrRecognizeSymbol @106
  CgrGetAnswers @107
  CgrLoadDict @108
  CgrSaveDict @109
  CgrFreeDict @110
  CgrGetDictStatus @111
  CgrAddWordToDict @112
  CgrCheckWordInDicts @113
  CgrSpellCheckWord @114
  CgrGetSetPicturesWeights @115
