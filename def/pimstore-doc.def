; pimstore-doc.def -- pimstore.lib export surface for Windows CE.
;
; Copyright (c) 2026 Akari API contributors
; SPDX-License-Identifier: MIT
;
; Derived exclusively from the official Microsoft CE
; documentation pages: each name below appears on a
; page whose Requirements row names this link library
; and an app-layer header (pimstore.h).  Names documented
; only under an OEM, driver or Platform Builder header
; are omitted, as are the header-inline helpers of
; Sphelper.h, whose "Link Library" row names the
; library the helper calls into rather than a symbol
; of that name.  No shared-source/device-dump/VS/PB-
; derived name is used.  Ordinals are not published;
; entries are name-only.  Added in M134: this library
; was documented but had no def, so nothing turned it
; into an import library and the declarations that
; cite it could not be linked.
; LIBRARY tag = documented Link Library row (pimstore.lib); the on-device module name is
; not published by the CE documentation.
LIBRARY pimstore.dll
EXPORTS
  CePimCommand
  IAppointment
  IContact
  IException
  IExceptions
  IFolder
  IPOlRecipient
  IPOutlookApp
  IPOutlookItemCollection
  IRecipient
  IRecipients
  IRecurrencePattern
  ITask
  ITimeZone
  OlBusyStatus
  OlCurrentCity
  OlDaysOfWeek
  OlDefaultFolders
  OlImportance
  OlItemType
  OlMeetingStatus
  OlRecurrenceType
  OlReminderOptions
  OlSensitivity
