;
; Derived exclusively from the official Microsoft CE
; documentation pages: each name below appears on the
; listed page whose Requirements row names this link
; library (tools/ce-manifest.py + tools/ce-fetch.py
; harvest; docs/inventory.md records every page).  No
; shared-source/device-dump/VS/PB-derived name is used.
; Ordinals are not published; entries are name-only.
; LIBRARY tag = documented Link Library row (commctrl.lib); the on-device module name is
; not published by the CE documentation.
LIBRARY commctrl.dll
EXPORTS
EXPORTS
  CommandBands_AddAdornments
  CommandBands_AddBands
  CommandBands_Create
  CommandBands_GetCommandBar
  CommandBands_GetRestoreInformation
  CommandBands_Show
  CommandBar_AddAdornments
  CommandBar_AddBitmap
  CommandBar_AlignAdornments
  CommandBar_Create
  CommandBar_DrawMenuBar
  CommandBar_GetMenu
  CommandBar_Height
  CommandBar_InsertComboBox
  CommandBar_InsertMenubar
  CommandBar_InsertMenubarEx
  CommandBar_Show
  CreateStatusWindow
  CreateToolbarEx
  CreateUpDownControl
  DPA_GetPtr
  DestroyPropertySheetPage
  DrawStatusText
  ImageList_RemoveAll
  InitCommonControls
  InitCommonControlsEx
  InvertRect

; 2026-09-19: ImageList_* removed from here (documented "Commctrl.lib, Imgctl.lib"; Imgctl is a
; documented gwes component linked into coredll.dll -> owner: coredll-doc.def; R1 cegcc coredll.def).
; +CreateToolbarEx/CreateUpDownControl/DPA_GetPtr/DestroyPropertySheetPage/InvertRect (doc + R1 commctrl.def).
; Ledger: docs/def-restructure-2026-09-19.tsv.
