; rapi-doc.def -- rapi.lib export surface for Windows CE.
;
; Copyright (c) 2026 Akari API contributors
; SPDX-License-Identifier: MIT
;
; Derived exclusively from the official Microsoft CE
; documentation pages: each name below appears on the
; listed page whose Requirements row names this link
; library (tools/ce-manifest.py + tools/ce-fetch.py
; harvest; docs/inventory.md records every page).  No
; shared-source/device-dump/VS/PB-derived name is used.
; Ordinals are not published; entries are name-only.
; LIBRARY tag = documented Link Library row (rapi.lib); the on-device module name is
; not published by the CE documentation.
LIBRARY rapi.dll
EXPORTS
  CeCheckPassword
  CeCloseHandle
  CeCopyFile
  CeCreateDirectory
  CeDeleteFile
  CeFindClose
  CeFindNextFile
  CeGetClassName
  CeGetDesktopDeviceCaps
  CeGetDiskFreeSpaceEx
  CeGetFileAttributes
  CeGetFileSize
  CeGetFileTime
  CeGetLastError
  CeGetSpecialFolderPath
  CeGetStoreInformation
  CeGetSystemMetrics
  CeGetSystemPowerStatusEx
  CeGetTempPath
  CeGetWindow
  CeGetWindowLong
  CeGetWindowText
  CeGlobalMemoryStatus
  CeMoveFile
  CeQueryInstructionSet
  CeRapiGetError
  CeRapiInit
  CeRapiInitEx
  CeRapiInvoke
  CeRapiUninit
  CeReadFile
  CeRegCloseKey
  CeRegDeleteKey
  CeRegDeleteValue
  CeRegEnumKeyEx
  CeRegEnumValue
  CeRegOpenKeyEx
  CeRegQueryInfoKey
  CeRegQueryValueEx
  CeRemoveDirectory
  CeSHCreateShortcut
  CeSHGetShortcutTarget
  CeSetEndOfFile
  CeSetFileAttributes
  CeSetFilePointer
  CeSyncStop
  CeWriteFile

; 2026-09-19: CeSyncStop moved in from ole32-doc.def (documented rapi.lib ee496864);
; 23 Ce*Database*/Ce*DBVol* removed (documented "Coredll.lib, Rapi.lib" -> coredll-doc.def; R1 cegcc coredll.def). Ledger: docs/def-restructure-2026-09-19.tsv.
