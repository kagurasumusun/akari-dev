; Akari WinCE API surface — public imports for mlang.dll (ARMV4I).
; Names and ordinals were recorded from a CE 6.0 export survey.
; Non-import-library exports are omitted. This text is original.
LIBRARY mlang.dll
EXPORTS
  IsConvertINetStringAvailable @110
  ConvertINetString @111
  ConvertINetUnicodeToMultiByte @112
  ConvertINetMultiByteToUnicode @113
  ConvertINetReset @114
  LcidToRfc1766W @121
  Rfc1766ToLcidW @123
