; Akari WinCE API surface — public imports for splusa.dll (ARMV4I).
; Names and ordinals were recorded from a CE 6.0 export survey.
; Non-import-library exports are omitted. This text is original.
LIBRARY splusa.dll
EXPORTS
  SplInit
  SplQuit
  SplOptionGet
  SplOptionSet
  SplLimitGet
  SplLimitSet
  SplCheck
  SplSuggest
  SplReplace
  SplAddUserDict
  SplRemUserDict
  SplClrUserDict
  SplSizeUserDict
  SplEnumUserDict
