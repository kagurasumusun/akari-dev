; Akari WinCE API surface — public imports for autodial.dll (ARMV4I).
; Names and ordinals were recorded from a CE 6.0 export survey.
; Non-import-library exports are omitted. This text is original.
LIBRARY autodial.dll
EXPORTS
  AutoDialInitializeModule
  AutoDialCleanupModule
  AutoDialStartConnection
  AutoDialEndConnection
  AutoDialGetConnectionStatus
