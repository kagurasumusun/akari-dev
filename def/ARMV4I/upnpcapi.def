; Akari WinCE API surface — public imports for upnpcapi.dll (ARMV4I).
; Names and ordinals were recorded from a CE 6.0 export survey.
; Non-import-library exports are omitted. This text is original.
LIBRARY upnpcapi.dll
EXPORTS
  UpnpAddDevice
  UpnpRemoveDevice
  UpnpPublishDevice
  UpnpUnpublishDevice
  UpnpSubmitPropertyEvent
  UpnpSetRawControlResponse
  UpnpSetControlResponse
  UpnpSetErrorResponse
  UpnpGetSCPDPath
  UpnpGetUDN
  UpnpUpdateEventedVariables
  RegisterNotification
  DeregisterNotification
  FindServicesCallback
  FindServices
  GetFirstService
  GetNextService
  FindServicesClose
  RegisterService
  DeregisterService
  SsdpStartup
  SsdpCleanup
  FindServicesCancel
