EXPORTS
  DllCanUnloadNow
  DllGetClassObject
  MoInitMediaType
  MoFreeMediaType
  MoCopyMediaType
  MoCreateMediaType
  MoDeleteMediaType
  MoDuplicateMediaType
  DMOEnum
  DMORegister
  DMORegisterFilter
  DMOUnregister
  DMOUnregisterFilter
  DMOGuidToStrA
  DMOGuidToStrW
  DMOStrToGuidA
  DMOStrToGuidW
  DMOGetTypes
  DMOGetName
