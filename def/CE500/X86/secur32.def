; Public import surface for secur32.dll (CE500, X86).
; Export names and ordinals recorded from the CE module survey.
; Non-import-library exports are omitted. This text is original.
LIBRARY secur32.dll
EXPORTS
  InitSecurityInterfaceW
  QuerySecurityPackageInfoW
  EnumerateSecurityPackagesW
  AcquireCredentialsHandleW
  QueryCredentialsAttributesW
  FreeCredentialsHandle
  InitializeSecurityContextW
  AcceptSecurityContext
  DeleteSecurityContext
  QueryContextAttributesW
  ApplyControlToken
  MakeSignature
  VerifySignature
  ImpersonateSecurityContext
  RevertSecurityContext
  FreeContextBuffer
  SealMessage
  UnsealMessage
  InitSecurityInterfaceA
  CeCredRead
  CeCredWrite
  CeCredFree
  EncryptMessage
  DecryptMessage
