; Public import surface for mmtimer.dll (CE500, X86).
; Export names and ordinals recorded from the CE module survey.
; Non-import-library exports are omitted. This text is original.
LIBRARY mmtimer.dll
EXPORTS
  timeBeginPeriod
  timeEndPeriod
  timeGetDevCaps
  timeGetTime
  timeSetEvent
  timeKillEvent
  timeGetTimeSinceInterrupt
  timeGetHardwareFrequency
