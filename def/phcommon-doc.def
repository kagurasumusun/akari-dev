; phcommon-doc.def -- PhCommon.dll export surface for Windows CE.
;
; Copyright (c) 2026 Akari API contributors
; SPDX-License-Identifier: MIT
;
; Derived exclusively from the official Microsoft CE
; documentation pages: each name below appears on a
; CE 6.0 page whose Requirements row reads
; "Library: PhCommon.dll" (module form; headers
; commandapi.hpp / databaseapi.hpp / phoneapi.hpp /
; settingsapi.hpp).  No shared-source/device-dump/VS/PB
; material is used.  Ordinals are not published;
; entries are name-only.
LIBRARY phcommon.dll
EXPORTS
  PHAddSpeedDialEntry
  PHAuthenticateUser
  PHCancelAuthenticationRequest
  PHGetActiveVolume
  PHGetAppWindow
  PHGetSetting
  PHGetVolumeSetting
  PHOnHookDialing
  PHProcessProvisionXML
  PHReadPIN
  PHSendCommandLine
  PHSetActiveVolume
  PHSetValue
  PHSetVolume
  PHValidateProvisionXML
  PHWritePIN
