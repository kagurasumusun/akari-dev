; AKARI_CE_IMPORT by this tree's headers.  No
; shared-source/device-dump/VS/PB-derived name is
; used.  Ordinals are not published; entries are
; name-only.
LIBRARY gpsapi.dll
EXPORTS
  GPSCloseDevice
  GPSOpenDevice
