; Public import surface for fwapi.dll (CE600, ARMV4I).
; Export names and ordinals recorded from the CE module survey.
; Non-import-library exports are omitted. This text is original.
LIBRARY fwapi.dll
EXPORTS
  FirewallCreateRule
  FirewallDeleteRule
  FirewallEnableRule
  FirewallGetRules
  FirewallEnable
  IsFirewallEnabled
  FirewallRefresh
  FirewallSetInterface
  IsInterfaceFirewalled
