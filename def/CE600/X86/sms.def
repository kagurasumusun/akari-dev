; Public import surface for sms.dll (CE600, X86).
; Export names and ordinals recorded from the CE module survey.
; Non-import-library exports are omitted. This text is original.
LIBRARY sms.dll
EXPORTS
  SmsSetMessageNotification
  SmsClearMessageNotification
  SmsOpen
  SmsClose
  SmsSendMessage
  SmsGetMessageSize
  SmsReadMessage
  SmsGetMessageStatus
  SmsSetSMSC
  SmsGetSMSC
  SmsGetBroadcastMsgRanges
  SmsSetBroadcastMsgRanges
  SmsGetTime
  SmsReceiveAllMessagesFromSIM @20
  SmsGetPhoneNumber
