; Public import surface for sim.dll (CE600, X86).
; Export names and ordinals recorded from the CE module survey.
; Non-import-library exports are omitted. This text is original.
LIBRARY sim.dll
EXPORTS
  SimInitialize @1
  SimDeinitialize @2
  SimGetDevCaps @3
  SimReadPhonebookEntry @4
  SimGetPhonebookStatus @5
  SimWritePhonebookEntry @6
  SimDeletePhonebookEntry @7
  SimGetPhoneLockedState @8
  SimUnlockPhone @9
  SimGetLockingStatus @10
  SimSetLockingStatus @11
  SimChangeLockingPassword @12
  SimGetSmsStorageStatus @13
  SimReadMessage @14
  SimWriteMessage @15
  SimDeleteMessage @16
  SimReadRecord @17
  SimWriteRecord @18
  SimGetRecordInfo @19
  SimReadRILMessage @20
  SimGetIMSI @21
